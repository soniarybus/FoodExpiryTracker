+def filter_items(items: list, query: str) -> list:
+    # Linear search: walk every element from index 0 to len-1, keeping those
+    # whose name contains the query as a substring (case-insensitive).
+    # Time complexity is O(n) — we inspect each FoodItem exactly once.
+    if not query:
+        return items  # empty query → no filtering, all items pass through
+
+    query_lower = query.lower()
+    result = []
+    for item in items:                          # one pass through the list
+        if query_lower in item.name.lower():    # substring check; both sides lowercased
+            result.append(item)                 # keep this item; move on to the next
+    return result
+
+
+def _match_count_text(match_count: int) -> str:
+    if match_count <= 0:
+        return "No direct matches"
+    if match_count == 1:
+        return "1 of your items matched"
+    return f"{match_count} of your items matched"
