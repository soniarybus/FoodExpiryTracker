+def clean_ingredient(text) -> str:
+    """Normalise one ingredient string for storage/display.
+
+    Round-tripping through encode(..., "backslashreplace") / decode
+    ("unicode_escape") turns literal "\\u00bc"-style text — which shows up
+    when a value has been JSON-encoded more than once, e.g. an old cache row
+    — into the real character (¼), while leaving already-correct unicode
+    text unchanged (it re-escapes and then decodes right back to itself).
+    The rest strips stray list/JSON punctuation left over from a raw
+    str(list) or partially-parsed JSON fragment.
+    """
+    if not text:
+        return ""
+    text = str(text)
+    try:
+        text = text.encode("ascii", "backslashreplace").decode("unicode_escape")
+    except (UnicodeDecodeError, UnicodeEncodeError):
+        pass
+    text = unicodedata.normalize("NFC", text)
+    text = text.strip().strip("[]").strip().strip("\"'").strip()
+    text = text.replace("\\", "").strip()
+    return text
+
+
+def is_online(timeout: float = 3.0) -> bool:
+    """Best-effort connectivity probe with a short timeout, so callers can
+    check up front whether it's worth calling the API at all instead of
+    waiting out a full request timeout before falling back to the cache."""
+    try:
+        requests.get("https://api.spoonacular.com", timeout=timeout)
+        return True
+    except (requests.exceptions.ConnectionError,
+            requests.exceptions.Timeout,
+            OSError):
+        return False
+    except Exception:
+        # Reached the network but got some other failure (e.g. non-2xx) —
+        # that still means the device is online.
+        return True
